import {
  getReallocationRequests,
} from '@/lib/api/availability.api';

import {
  getResourceAllocation,
} from '@/lib/api/resource-allocations.api';

async function loadReallocationRequests() {
  const records = await getReallocationRequests();

  return Promise.all(
    records.map(async (record) => {
      let resultingAllocationActive = false;

      if (
        record.status === 'Approved' &&
        record.resultingAllocationId
      ) {
        try {
          const allocation =
            await getResourceAllocation(
              record.resultingAllocationId
            );

          resultingAllocationActive =
            allocation.isActive === true &&
            allocation.status === 'Allocated';

        } catch (error) {
          console.error(
            `Unable to verify resulting allocation ${record.resultingAllocationId}:`,
            error
          );
        }
      }

      return {
        id: record.id,

        unavailability_id:
          record.userUnavailabilityId,

        source_user_id:
          record.currentUserId,

        source_user_name:
          record.currentUserName,

        resource_type: 'License' as const,

        asset_id: null,
        asset_tag: null,

        license_allocation_id:
          record.resourceAllocationId,

        resulting_allocation_id:
          record.resultingAllocationId,

        resulting_allocation_active:
          resultingAllocationActive,

        software_name:
          record.softwareName,

        target_user_id:
          record.targetUserId,

        target_user_name:
          record.targetUserName,

        requested_by:
          record.requestedBy,

        justification:
          record.remarks,

        status:
          record.status,

        decided_by:
          record.decidedBy,

        decided_at:
          record.decidedAt,

        decision_notes:
          record.decisionRemarks,

        created_at:
          record.createdAt,
      };
    })
  );
}

export default loadReallocationRequests;
