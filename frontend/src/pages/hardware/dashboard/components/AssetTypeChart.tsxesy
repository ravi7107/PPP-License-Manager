import {
    ResponsiveContainer,
    PieChart,
    Pie,
    Cell,
    Tooltip,
    Legend,
} from "recharts";

type Props = {
    data: {
        assetType: string;
        assetCount: number;
    }[];
};

const COLORS = [
    "#2563eb",
    "#16a34a",
    "#f59e0b",
    "#dc2626",
    "#7c3aed",
    "#0891b2",
    "#ea580c",
    "#64748b",
];

export default function AssetTypeChart({ data }: Props) {
    return (
        <div className="rounded-xl border bg-white dark:bg-slate-900 p-5 shadow-sm">
            <h2 className="mb-4 text-lg font-semibold">
                Assets by Type
            </h2>

            <ResponsiveContainer width="100%" height={320}>
                <PieChart>
                    <Pie
                        data={data}
                        dataKey="assetCount"
                        nameKey="assetType"
                        innerRadius={60}
                        outerRadius={110}
                        label
                    >
                        {data.map((_, index) => (
                            <Cell
                                key={index}
                                fill={COLORS[index % COLORS.length]}
                            />
                        ))}
                    </Pie>

                    <Tooltip />
                    <Legend />
                </PieChart>
            </ResponsiveContainer>
        </div>
    );
}
