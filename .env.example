# Copy this file to .env and fill in real values. Never commit the real .env.
POSTGRES_PASSWORD=change-me
JWT_KEY=change-me-to-a-long-random-string

# PR approval notification emails (Purchase Requisition module).
# EmailServiceRouter prefers GraphMail below if it's filled in; SMTP
# further down is only used as a fallback if GraphMail is left blank.
# Leaving BOTH blank is fine too - emails just get logged, not sent.

# Microsoft Graph (primary path) - sends as the shared mailbox
# approvals@ppspl.in. TenantId/ClientId/ClientSecret come from the app
# registration in Entra admin center (App registrations > this app >
# Overview, and Certificates & secrets for the client secret). Requires:
#   1. Mail.Send Application permission granted + admin-consented on
#      that app registration.
#   2. An Exchange Online Application Access Policy scoping the app to
#      just this mailbox, e.g.:
#      New-ApplicationAccessPolicy -AppId <GRAPH_CLIENT_ID> -PolicyScopeGroupId approvals@ppspl.in -AccessRight RestrictAccess
GRAPH_TENANT_ID=change-me
GRAPH_CLIENT_ID=change-me
GRAPH_CLIENT_SECRET=change-me
GRAPH_SENDER_ADDRESS=approvals@ppspl.in

# SMTP (fallback path only - leave blank if Graph above is filled in).
# Requires SMTP AUTH enabled for this mailbox in the Exchange admin
# center first - see Set-CASMailbox -SmtpClientAuthenticationDisabled
# $false - and the account must not be blocked by MFA/Conditional
# Access for basic-auth SMTP submission, or sending will fail even with
# correct credentials.
# SMTP_USERNAME=approvals@ppspl.in
# SMTP_PASSWORD=change-me
# SMTP_FROM_ADDRESS=approvals@ppspl.in
# Optional overrides - safe to leave unset, defaults match Microsoft 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_ENABLE_SSL=true
# SMTP_FROM_NAME=PPS SmartAsset
