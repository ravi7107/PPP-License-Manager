# Copy this file to .env (development), .env.staging, or .env.production
# and fill in real values. Never commit the filled-in files - only
# .env.example is tracked in git.
#
# IMPORTANT: "localhost" here refers to the phone/emulator itself, not
# your computer or server. On a physical device this must be your
# backend's real LAN IP or public hostname (e.g. the same address the
# existing web app already uses - see docker-compose.yml's
# App__PublicBaseUrl). On an Android emulator, "localhost" from the
# host machine's perspective is 10.0.2.2, not 127.0.0.1.
#
# This app talks only to the existing PPS backend's REST API - never
# directly to Postgres, and no database credentials are ever present
# in this app.

# Development - typically your backend running locally or the shared
# dev server.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api
EXPO_PUBLIC_API_ENV_NAME=Development

# Staging (example - copy this block into .env.staging)
# EXPO_PUBLIC_API_URL=https://staging.your-domain.example/api
# EXPO_PUBLIC_API_ENV_NAME=Staging

# Production (example - copy this block into .env.production)
# EXPO_PUBLIC_API_URL=https://api.your-domain.example/api
# EXPO_PUBLIC_API_ENV_NAME=Production
